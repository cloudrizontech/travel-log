---
import { getCollection } from "astro:content";

const travels = (await getCollection("travels")).sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

const title = "Travels · Travel Log";
const description = "Trips, cities, photographs, memories and notes.";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <style>
      :global(*) {
        box-sizing: border-box;
      }

      :global(body) {
        margin: 0;
        background: #f8f7f3;
        color: #242424;
        font-family: Arial, Helvetica, sans-serif;
      }

      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 32px;
      }

      header {
        padding: 36px 0;
        border-bottom: 1px solid #d8d6d0;
      }

      .brand {
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
      }

      .back {
        display: inline-block;
        margin-top: 24px;
        color: #777;
        text-decoration: none;
        font-size: 14px;
      }

      .back:hover {
        color: #000;
      }

      .hero {
        padding: 70px 0 50px;
      }

      .hero h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(44px, 7vw, 76px);
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -0.04em;
      }

      .hero p {
        max-width: 520px;
        margin: 28px 0 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 20px;
        line-height: 1.5;
        color: #666;
      }

      .section {
        padding: 20px 0 100px;
      }

      .entries {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
      }

      .entry {
        display: block;
        color: inherit;
        text-decoration: none;
      }

      .entry-image {
        width: 100%;
        height: 320px;
        display: block;
        object-fit: cover;
      }

      .entry h2 {
        margin: 28px 0 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 34px;
        font-weight: 400;
        line-height: 1.05;
      }

      .entry:hover h2 {
        text-decoration: underline;
        text-decoration-thickness: 1px;
        text-underline-offset: 8px;
      }

      .location {
        margin-top: 14px;
        color: #777;
        font-size: 14px;
      }

      .entry p {
        margin-top: 18px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: 17px;
        line-height: 1.6;
      }

      footer {
        padding: 40px 0;
        border-top: 1px solid #d8d6d0;
        color: #777;
        font-size: 13px;
      }

      @media (max-width: 800px) {
        .container {
          padding: 0 20px;
        }

        .entries {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="container">
        <div class="brand">Travel Log</div>

        <a class="back" href={import.meta.env.BASE_URL}>
          ← Back to Travel Log
        </a>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <h1>Travels</h1>
          <p>{description}</p>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="entries">
            {
              travels.map((travel) => {
                const folder = travel.id.split("-")[0];

                return (
                  <a
                    class="entry"
                    href={`${import.meta.env.BASE_URL}/travels/${travel.id}/`}
                  >
                    <img
                      class="entry-image"
                      src={`${import.meta.env.BASE_URL}/images/${folder}/${folder}-hero.jpg`}
                      alt={travel.data.title}
                    />

                    <h2>{travel.data.title}</h2>

                    <div class="location">
                      {travel.data.location} ·{" "}
                      {travel.data.startDate.toLocaleDateString("en-US", {
                        month: "long",
                        year: "numeric",
                      })}
                    </div>

                    <p>{travel.data.description}</p>
                  </a>
                );
              })
            }
          </div>
        </div>
      </section>
    </main>

    <footer>
      <div class="container">Travel Log · A personal archive</div>
    </footer>
  </body>
</html>
